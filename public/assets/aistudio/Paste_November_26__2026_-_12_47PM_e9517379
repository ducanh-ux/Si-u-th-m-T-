];

/* ============================================================
   PHẦN 2: LOGIC GAME — thường không cần sửa
   ============================================================ */
let CASE = null;
let S = {};
function startCase(i) {
  CASE = CASES[i];
  S = { tab: "scene", loc: CASE.locations[0].id, sus: CASE.suspects[0].id,
        clues: [], done: {}, log: {}, sel: { culprit: null, ev: [] }, end: null };
  render();
}
const $ = s => document.querySelector(s);
const has = id => S.clues.includes(id);
const toast = msg => { const t = $("#toast"); t.textContent = msg; t.classList.add("show");
  clearTimeout(toast.h); toast.h = setTimeout(() => t.classList.remove("show"), 2200); };
const gain = id => { if (id && !has(id)) { S.clues.push(id); toast("Manh mối mới: " + CASE.clues[id].name); } };

function render() {
  if (!CASE) {
    $("#title").textContent = "Hồ sơ thám tử";
    $("#intro").textContent = "Chọn một vụ án để bắt đầu.";
    $("#nav").innerHTML = "";
    $("#main").innerHTML = CASES.map((c, i) => `<button class="act" onclick="startCase(${i})"><b>${c.title}</b><span class="res">${c.blurb || ""}</span></button>`).join("");
    return;
  }
  $("#title").textContent = CASE.title;
  $("#intro").textContent = CASE.intro;
  const tabs = [["scene","Hiện trường"],["people","Nghi phạm"],["notes","Sổ tay (" + S.clues.length + ")"],["accuse","Buộc tội"]];
  $("#nav").innerHTML = tabs.map(([k,n]) => `<button class="${S.tab===k?"on":""}" onclick="S.tab='${k}';render()">${n}</button>`).join("") + `<button onclick="CASE=null;render()">Đổi vụ án</button>`;
  $("#main").innerHTML = { scene: viewScene, people: viewPeople, notes: viewNotes, accuse: viewAccuse }[S.tab]();
}

function viewScene() {
  const L = CASE.locations.find(l => l.id === S.loc);
  const chips = CASE.locations.map(l => `<button class="chip ${l.id===S.loc?"on":""}" onclick="S.loc='${l.id}';render()">${l.name}</button>`).join("");
  const items = L.items.map((it, i) => {
    if (it.needs && !has(it.needs)) return "";
    const k = L.id + i, d = S.done[k];
    return d ? `<div class="act done">${it.label}<span class="res">${it.text}</span></div>`
             : `<button class="act" onclick="search('${L.id}',${i})">${it.label}</button>`;
  }).join("");
  return `<div class="row">${chips}</div><div class="where">${L.desc}</div>${items}`;
}
function search(locId, i) {
  const it = CASE.locations.find(l => l.id === locId).items[i];
  S.done[locId + i] = true; gain(it.clue); render();
}

function viewPeople() {
  const P = CASE.suspects.find(s => s.id === S.sus);
  const chips = CASE.suspects.map(s => `<button class="chip ${s.id===S.sus?"on":""}" onclick="S.sus='${s.id}';render()">${s.name}</button>`).join("");
  const qs = P.questions.map((q, i) => {
    if (q.needs && !has(q.needs)) return "";
    const k = P.id + i;
    return S.done[k] ? `<div class="q">Bạn: ${q.q}</div><div class="a">${P.name}: ${q.a}</div>`
                     : `<button class="act" onclick="ask('${P.id}',${i})">${q.q}</button>`;
  }).join("");
  const cf = !P.confront ? "" : `<h3 style="margin-top:22px">Đưa bằng chứng đối chất</h3>` +
    (S.clues.length ? `<div class="row">${S.clues.map(id => `<button class="chip" onclick="confront('${P.id}','${id}')">${CASE.clues[id].name}</button>`).join("")}</div>`
                    : `<p class="muted">Bạn chưa có bằng chứng nào để đưa ra.</p>`) +
    (S.log[P.id] || []).map(l => `<div class="q">Bạn đưa ra: ${l.name}</div><div class="a">${P.name}: ${l.a}</div>`).join("");
  return `<div class="row">${chips}</div><div class="box"><h3>${P.name}</h3><div class="muted">${P.role}</div><p>${P.bio}</p></div>${qs}${cf}`;
}
function ask(pid, i) {
  const q = CASE.suspects.find(s => s.id === pid).questions[i];
  S.done[pid + i] = true; gain(q.clue); render();
}

function confront(pid, cid) {
  const P = CASE.suspects.find(s => s.id === pid);
  const e = (P.confront || []).find(x => x.with === cid);
  const ok = e && (!e.after || S.done[pid + "c" + e.after]);
  const a = ok ? e.a : (P.deny || "Cái đó không liên quan đến tôi.");
  if (ok) { S.done[pid + "c" + cid] = true; gain(e.clue); }
  (S.log[pid] = S.log[pid] || []).push({ name: CASE.clues[cid].name, a }); render();
}

function viewNotes() {
  if (!S.clues.length) return `<p class="muted">Sổ tay còn trống. Hãy khám xét hiện trường và thẩm vấn nghi phạm.</p>`;
  return S.clues.map(id => `<div class="card"><b>${CASE.clues[id].name}</b><small>${CASE.clues[id].text}</small></div>`).join("");
}

function viewAccuse() {
  if (S.end) return endBox();
  const who = CASE.suspects.map(s => `<label class="lbl"><input type="radio" name="w" ${S.sel.culprit===s.id?"checked":""} onchange="S.sel.culprit='${s.id}';render()"><span><b>${s.name}</b> <span class="muted">${s.role}</span></span></label>`).join("");
  const max = CASE.solution.maxEvidence, full = S.sel.ev.length >= max;
  const ev = S.clues.length ? S.clues.map(id => { const on = S.sel.ev.includes(id);
    return `<label class="lbl"><input type="checkbox" ${on?"checked":""} ${full&&!on?"disabled":""} onchange="toggleEv('${id}')"><span>${CASE.clues[id].name}</span></label>`; }).join("")
                            : `<p class="muted">Bạn chưa có manh mối nào.</p>`;
  return `<h3>Ai là hung thủ?</h3>${who}<h3 style="margin-top:20px">Bằng chứng nộp cho tòa</h3><p class="muted">Đã chọn ${S.sel.ev.length}/${max}. Chỉ được nộp tối đa ${max} bằng chứng.</p>${ev}
    <button class="go" ${S.sel.culprit?"":"disabled"} onclick="accuse()">Buộc tội</button>`;
}
function toggleEv(id) { const a = S.sel.ev, i = a.indexOf(id);
  if (i >= 0) a.splice(i, 1); else if (a.length < CASE.solution.maxEvidence) a.push(id);
  render(); }

function accuse() {
  const sol = CASE.solution;
  const ok = S.sel.culprit === sol.culprit && sol.keyClues.every(c => S.sel.ev.includes(c));
  S.end = ok ? { kind: "win", text: sol.win } : { kind: "lose", text: sol.lose };
  render();
}
function endBox() {
  const win = S.end.kind === "win";
  return `<div class="end ${S.end.kind}"><h2>${win ? "Vụ án đã được phá" : "Chưa thể kết án"}</h2><p>${S.end.text}</p>
    <button class="go" onclick="S.end=null;${win ? "CASE=null;" : ""}render()">${win ? "Về danh sách vụ án" : "Quay lại điều tra"}</button></div>`;
}

render();
</script>
