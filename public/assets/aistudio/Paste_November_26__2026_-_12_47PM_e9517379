<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Đêm mưa ở biệt thự Hoàng Gia</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;600&family=Bitter:wght@600;800&display=swap" rel="stylesheet">
<style>
:root{--bg:#13202b;--panel:#1c2d3b;--paper:#e4e1d8;--ink:#1d2430;--thread:#d1493b;--mute:#8fa3b3;--line:#2f4558;--ok:#6fbf8e;color-scheme:dark}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:#dfe7ee;font:16px/1.6 'Be Vietnam Pro',system-ui,sans-serif}
h1,h2,h3{font-family:'Bitter',Georgia,serif;margin:0}
.wrap{max-width:760px;margin:0 auto;padding:20px 16px 80px}
header h1{font-size:1.7rem;font-weight:800}
header p{color:var(--mute);margin:.4rem 0 0}
nav{display:flex;gap:6px;margin:18px 0;border-bottom:1px solid var(--line);overflow-x:auto}
nav button{background:none;border:0;color:var(--mute);font:inherit;padding:10px 14px;cursor:pointer;border-bottom:3px solid transparent;white-space:nowrap}
nav button.on{color:#fff;border-color:var(--thread)}
button:focus-visible,input:focus-visible{outline:2px solid #fff;outline-offset:2px}
.row{display:flex;flex-wrap:wrap;gap:8px;margin:12px 0}
.chip{background:var(--panel);border:1px solid var(--line);color:#dfe7ee;border-radius:20px;padding:6px 14px;font:inherit;cursor:pointer}
.chip.on{background:var(--thread);border-color:var(--thread);color:#fff}
.box{background:var(--panel);border:1px solid var(--line);border-radius:6px;padding:14px 16px;margin:12px 0}
.act{display:block;width:100%;text-align:left;background:var(--panel);border:1px solid var(--line);color:#dfe7ee;font:inherit;padding:11px 14px;border-radius:6px;margin:8px 0;cursor:pointer}
.act:hover{border-color:var(--mute)}
.act.done{cursor:default;background:transparent;border-style:dashed}
.act .res{display:block;color:#fff;margin-top:6px;padding-top:6px;border-top:1px solid var(--line)}
.q{color:var(--mute)} .a{color:#fff;margin:2px 0 10px}
.card{background:var(--paper);color:var(--ink);border-left:6px solid var(--thread);border-radius:3px;padding:10px 14px;margin:10px 0}
.card b{font-family:'Bitter',serif}
.card small{display:block;margin-top:4px}
.lbl{display:flex;gap:10px;align-items:flex-start;padding:8px 0;cursor:pointer}
.go{background:var(--thread);color:#fff;border:0;border-radius:6px;font:600 1rem 'Be Vietnam Pro',sans-serif;padding:12px 22px;cursor:pointer;margin-top:10px}
.go:disabled{opacity:.4;cursor:not-allowed}
.muted{color:var(--mute)}
.where{background:#26414f;color:#fff4d6;border-left:4px solid var(--thread);border-radius:6px;padding:12px 16px;margin:12px 0;font-size:1.03rem}
.end{border:2px solid var(--line);border-radius:6px;padding:16px;margin-top:16px}
.end.win{border-color:var(--ok)} .end.lose{border-color:var(--thread)}
#toast{position:fixed;left:50%;bottom:24px;transform:translateX(-50%);background:var(--paper);color:var(--ink);padding:10px 18px;border-radius:6px;font-weight:600;opacity:0;pointer-events:none;transition:opacity .25s;max-width:90vw}
#toast.show{opacity:1}
</style>
</head>
<body>
<div class="wrap">
  <header><h1 id="title"></h1><p id="intro"></p></header>
  <nav id="nav"></nav>
  <main id="main"></main>
</div>
<div id="toast" role="status"></div>

